{
  // Menu rows for Affinity. omarchy-install-affinity appends the "  \"..." lines
  // below to ~/.config/omarchy/extensions/omarchy-menu.jsonc, so keep each row on
  // one line and keep the parent rows byte-identical to what
  // omarchy-remove-affinity deletes.
  "install.creative": {"icon":"󰃣","label":"Creative"},
  "install.creative.affinity": {"icon":"","label":"Affinity","when":"[[ ! -f \"${OMARCHY_AFFINITY_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-affinity}/prefix/drive_c/Program Files/Affinity/Affinity/Affinity.exe\" ]]","action":"omarchy-launch-floating-terminal-with-presentation omarchy-install-affinity"},
  "remove.creative": {"icon":"󰃣","label":"Creative","title":"Remove"},
  "remove.creative.affinity": {"icon":"","label":"Affinity","when":"[[ -d \"${OMARCHY_AFFINITY_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-affinity}\" ]]","action":"omarchy-launch-floating-terminal-with-presentation omarchy-remove-affinity"},
}
