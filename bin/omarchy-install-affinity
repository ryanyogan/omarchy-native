#!/bin/bash
# omarchy:summary=Install or repair Affinity with themed progress and recoverable setup.
# omarchy:args=[--terminal]
# omarchy:requires-sudo=true
set -euo pipefail
umask 077
# shellcheck source=omarchy-affinity-env
source "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/omarchy-affinity-env"
# shellcheck source=omarchy-affinity-ui
source "$OMARCHY_NATIVE_PATH/bin/omarchy-affinity-ui"
case "${1-}" in
  -h|--help) echo 'Usage: omarchy-install-affinity [--terminal]'; exit 0 ;;
  --terminal) exec "$OMARCHY_NATIVE_PATH/bin/omarchy-setup-affinity" --install ;;
  '') ;;
  *) echo 'Unknown option.' >&2; exit 2 ;;
esac
helper="$OMARCHY_NATIVE_PATH/libexec/affinity-lifecycle.py"
affinity_lock -x
python3 "$helper" check
python3 "$helper" idle
python3 "$helper" capture
if python3 "$helper" needs-packages; then sudo -v; fi
affinity_wine_env
affinity_cursor_env
# ---------------------------------------------------------------------------
# Patched Wine runner, pinned by checksum and replaced when the version bumps.
download() {
  local url="$1" dest="$2"
  local resume=(--continue-at -)
  [[ ${3-} == fresh ]] && resume=()
  mkdir -p "${dest%/*}"
  curl --fail --location --retry 3 "${resume[@]}" --silent --show-error "$url" --output "$dest.part"
  mv "$dest.part" "$dest"
}

install_runner() {
vendored_version=""
if [[ -f $AFFINITY_WINE/.omarchy-version ]]; then
  read -r vendored_version <"$AFFINITY_WINE/.omarchy-version"
fi

if [[ $vendored_version != "$AFFINITY_WINE_VERSION" ]]; then
  archive="$AFFINITY_CACHE/${AFFINITY_WINE_URL##*/}"

  if [[ ! -f $archive ]] || ! sha256sum --status --check <<<"$AFFINITY_WINE_SHA256  $archive"; then
    echo
    echo "Downloading ElementalWarrior Wine $AFFINITY_WINE_VERSION..."
    rm -f "$archive"
    download "$AFFINITY_WINE_URL" "$archive"
  fi

  if ! sha256sum --status --check <<<"$AFFINITY_WINE_SHA256  $archive"; then
    echo "Checksum mismatch for $archive; refusing to install it." >&2
    exit 1
  fi

  echo "Unpacking Wine..."
  mkdir -p "$AFFINITY_ROOT"
  staging=$(mktemp -d "$AFFINITY_ROOT/wine-staging-XXXXXX")
  tar -xJf "$archive" -C "$staging"
  [[ -x $staging/$AFFINITY_WINE_ARCHIVE_DIR/bin/wine ]] || { echo 'Wine archive is incomplete.' >&2; return 1; }
  previous="$AFFINITY_ROOT/wine-previous"
  [[ ! -e $previous ]] || { echo 'An interrupted runner replacement needs recovery from wine-previous.' >&2; return 1; }
  if [[ -d $AFFINITY_WINE ]]; then mv "$AFFINITY_WINE" "$previous"; fi
  if ! mv "$staging/$AFFINITY_WINE_ARCHIVE_DIR" "$AFFINITY_WINE"; then
    if [[ -d $previous ]]; then mv "$previous" "$AFFINITY_WINE"; fi
    return 1
  fi
  if [[ -d $previous ]]; then rm -rf "$previous"; fi
  rmdir "$staging"
  printf '%s\n' "$AFFINITY_WINE_VERSION" >"$AFFINITY_WINE/.omarchy-version"
fi

}

# ---------------------------------------------------------------------------
# Prefix. Each step is skipped when its result is already in place, so a rerun
# after a crash or Ctrl-C picks up where it stopped.
install_winetricks() {
  if [[ -n ${OMARCHY_AFFINITY_WINETRICKS-} ]]; then
    [[ -x $AFFINITY_WINETRICKS ]] || { echo 'The custom winetricks executable is missing.' >&2; return 1; }
    return 0
  fi
  if ! sha256sum --status --check <<<"$AFFINITY_WINETRICKS_SHA256  $AFFINITY_WINETRICKS"; then
    download "$AFFINITY_WINETRICKS_URL" "$AFFINITY_WINETRICKS" fresh
    sha256sum --status --check <<<"$AFFINITY_WINETRICKS_SHA256  $AFFINITY_WINETRICKS" || {
      echo 'Winetricks checksum mismatch; refusing to run it.' >&2; return 1;
    }
  fi
  chmod 700 "$AFFINITY_WINETRICKS"
}

install_prefix() {
affinity_wine_env
mkdir -p "$AFFINITY_STATE"

if [[ ! -f $AFFINITY_PREFIX/system.reg ]]; then
  echo
  echo "Creating the Wine prefix at $AFFINITY_PREFIX..."
  mkdir -p "$AFFINITY_PREFIX"
  # No Mono/Gecko: winetricks installs real .NET next, and the Gecko dialog
  # would be the only prompt in the whole run.
  WINEDLLOVERRIDES="mscoree=;mshtml=;$WINEDLLOVERRIDES" wineboot --update
fi

# Winetricks temporarily replaces WINEDLLOVERRIDES while installing .NET.
# Persist this override before those steps so its Wine processes cannot create
# generic launcher entries and MIME associations in the user's desktop.
"$WINE" reg add 'HKEY_CURRENT_USER\Software\Wine\DllOverrides' /v winemenubuilder.exe /t REG_SZ /d '' /f

 }

install_verb() {
  local verb="$1"
  grep -qxF "$verb" "$AFFINITY_PREFIX/winetricks.log" 2>/dev/null && return 0
  export WINETRICKS_GUI=none W_CACHE="$AFFINITY_CACHE/winetricks"
  "$AFFINITY_WINETRICKS" --unattended "$verb" || grep -qxF "$verb" "$AFFINITY_PREFIX/winetricks.log"
}

configure_prefix() {
# Registry tweaks. Keying them on a marker keeps reruns quiet.
if [[ ! -f $AFFINITY_STATE/registry-done ]]; then
  echo
  echo "Applying Wine registry settings..."
  # Stay on XWayland: Hyprland's rules key on the affinity.exe X11 class, and
  # Wine's Wayland driver is not what upstream tests against.
  "$WINE" reg add 'HKEY_CURRENT_USER\Software\Wine\Drivers' /v Graphics /t REG_SZ /d x11 /f
  # Dark Win32 chrome for the few native dialogs Affinity still opens.
  "$AFFINITY_WINE/bin/regedit" "$OMARCHY_NATIVE_PATH/default/affinity/wine-dark-theme.reg"
  touch "$AFFINITY_STATE/registry-done"
fi
affinity_apply_dpi

}

# ---------------------------------------------------------------------------
# The app. Canva's installer is a normal Windows wizard with no silent switch,
# so this is the one place the user clicks through anything.
install_app() {
if [[ ! -f $AFFINITY_EXE ]]; then
  installer="$AFFINITY_CACHE/Affinity-x64.exe"
  if [[ ! -s $installer || ! -f $installer.complete ]]; then
    echo
    echo "Downloading the Affinity installer..."
    download "$AFFINITY_INSTALLER_URL" "$installer" fresh
    touch "$installer.complete"
  fi

  log="$AFFINITY_STATE/affinity-setup.log"
  "$WINE" "$installer" >"$log" 2>&1 || true
  wineserver --wait

  if [[ ! -f $AFFINITY_EXE ]]; then
    echo "Affinity.exe did not appear at $AFFINITY_EXE." >&2
    echo "Setup log: $log. Rerun omarchy-install-affinity to try the wizard again." >&2
    exit 1
  fi

  rm -f "$installer" "$installer.complete"
fi

}

install_desktop() {
# ---------------------------------------------------------------------------
# Desktop integration: icon, launcher, file associations.
install -Dm644 "$OMARCHY_NATIVE_PATH/default/applications/icons/affinity.svg" "$AFFINITY_ICON_FILE"
gtk-update-icon-cache "${AFFINITY_ICON_FILE%/hicolor/*}/hicolor" &>/dev/null || true

install -Dm644 "$OMARCHY_NATIVE_PATH/default/applications/affinity.desktop" "$AFFINITY_DESKTOP_FILE"
update-desktop-database "${AFFINITY_DESKTOP_FILE%/*}" &>/dev/null || true

install -Dm644 "$OMARCHY_NATIVE_PATH/default/mime/omarchy-affinity.xml" "$AFFINITY_MIME_FILE"
update-mime-database "${AFFINITY_MIME_FILE%/packages/*}" &>/dev/null || true
# Register Open With support, but do not make a known-broken document handoff
# the default. Restore any associations taken by the previous installer.
python3 "$helper" restore-mime

# Hyprland rules: a fragment in ~/.config/hypr plus one require line at the end
# of the user's hyprland.lua, where Omarchy invites personal additions.
install -Dm644 "$OMARCHY_NATIVE_PATH/default/hypr/apps/affinity.lua" "$AFFINITY_HYPR_FILE"
if [[ -f $AFFINITY_HYPR_CONFIG ]] && ! grep -qF -- '-- omarchy-affinity' "$AFFINITY_HYPR_CONFIG"; then
  printf '\n%s\n' "$AFFINITY_HYPR_REQUIRE" >>"$AFFINITY_HYPR_CONFIG"
fi
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE-} ]]; then
  hyprctl reload >/dev/null 2>&1 || true
fi

}

affinity_ui_start 'Install Affinity' "$(( ${#AFFINITY_WINETRICKS_VERBS[@]} + 9 ))" "$AFFINITY_STATE/install-$(date +%Y%m%d-%H%M%S).log"
if [[ ! -f $AFFINITY_EXE ]]; then
  printf '\n  Complete the Affinity setup window when it appears.\n  Keep the default install location.\n\n'
fi
affinity_step 'Preparing system dependencies' python3 "$helper" packages
affinity_step 'Preparing the Wine runtime' install_runner
affinity_step 'Preparing the setup tools' install_winetricks
affinity_step 'Creating your private app environment' install_prefix
for verb in "${AFFINITY_WINETRICKS_VERBS[@]}"; do
  case "$verb" in
    dotnet48) label='Preparing the app framework · allow 10 minutes' ;;
    corefonts|tahoma) label='Installing typefaces' ;;
    dxvk|renderer=vulkan) label='Preparing Vulkan rendering' ;;
    *) label='Installing Windows libraries' ;;
  esac
  affinity_step "$label" install_verb "$verb"
done
affinity_step 'Matching your display and desktop' configure_prefix
affinity_step 'Installing Affinity · complete its setup window' install_app
affinity_step 'Adding the app launcher and file types' install_desktop
affinity_step 'Removing setup-only files' python3 "$helper" prune-runtime
affinity_step 'Recording recovery information' python3 "$helper" seal
printf '\n\n  Affinity is ready. Open it from your app launcher.\n\n  ✓ Display and menus configured\n  ✓ Recovery information saved\n'
