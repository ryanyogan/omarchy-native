#!/bin/bash
# omarchy:summary=Back up Affinity data, then remove its runtime and installer-owned dependencies.
# omarchy:args=[--dry-run|--yes]
# omarchy:requires-sudo=true
set -euo pipefail
umask 077
# shellcheck source=omarchy-affinity-env
source "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/omarchy-affinity-env"
# shellcheck source=omarchy-affinity-ui
source "$OMARCHY_NATIVE_PATH/bin/omarchy-affinity-ui"
helper="$OMARCHY_NATIVE_PATH/libexec/affinity-lifecycle.py"
case "${1-}" in
  --dry-run) exec python3 "$helper" plan ;;
  -h|--help) echo 'Usage: omarchy-remove-affinity [--dry-run|--yes]'; exit 0 ;;
  --yes) ;;
  '')
    if [[ ! -t 0 ]]; then exec "$OMARCHY_NATIVE_PATH/bin/omarchy-setup-affinity" --uninstall; fi
    python3 "$helper" plan
    gum confirm 'Back up your data and uninstall Affinity?' || exit 0
    ;;
  *) echo 'Unknown option.' >&2; exit 2 ;;
esac
affinity_lock -x
python3 "$helper" idle
# Authenticate in the visible terminal before output is captured.
if [[ -f $AFFINITY_STATE/ownership.json ]] && jq -e '.packages | length > 0' "$AFFINITY_STATE/ownership.json" >/dev/null; then
  sudo -v
fi
affinity_ui_start 'Uninstall Affinity' 2 "$HOME/Affinity Backups/logs/uninstall-$(date +%Y%m%d-%H%M%S).log"
affinity_step 'Preserving your work and removing installed files' python3 "$helper" remove
refresh() {
  update-mime-database "${XDG_DATA_HOME:-$HOME/.local/share}/mime" || true
  update-desktop-database "${AFFINITY_DESKTOP_FILE%/*}" || true
  gtk-update-icon-cache "${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor" || true
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE-} ]]; then hyprctl reload; fi
}
affinity_step 'Refreshing the app launcher' refresh
printf '\nAffinity removed. Your recovery data is in ~/Affinity Backups.\n'
