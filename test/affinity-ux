#!/usr/bin/env python3
"""Live tooltip/focus/cursor checks: English UI, single 2x display at (0, 0).

Run with the Vector studio visible and Home/dialogs dismissed. Briefly takes
the pointer to three tools; does not click, edit documents or write settings.
Requires libX11, libXtst, libXfixes and hyprctl. Keep the pointer still.
"""
import ctypes as c
import json
import os
import subprocess
import time


def query(name):
    return json.loads(subprocess.check_output(['hyprctl', name, '-j']))


def dispatch(expression):
    subprocess.run(['hyprctl', 'eval', 'hl.dispatch(' + expression + ')'],
                   check=True, stdout=subprocess.DEVNULL)


monitors = query('monitors')
assert len(monitors) == 1 and monitors[0]['scale'] == 2
assert monitors[0]['x'] == monitors[0]['y'] == 0
zero_scaling = json.loads(subprocess.check_output(
    ['hyprctl', 'getoption', 'xwayland:force_zero_scaling', '-j']))
assert zero_scaling.get('bool'), 'Requires XWayland physical-coordinate scaling'
windows = query('clients')
main, = [w for w in windows if w['class'] == 'affinity.exe' and w['title'] == 'Affinity']
assert main['xwayland']
assert not [w for w in windows if w['class'] == 'affinity.exe' and w['address'] != main['address']], 'Dismiss Home/dialogs first'
original = query('cursorpos')
x = c.CDLL('libX11.so.6')
t = c.CDLL('libXtst.so.6')
fixes = c.CDLL('libXfixes.so.3')
x.XOpenDisplay.argtypes = [c.c_char_p]
x.XOpenDisplay.restype = c.c_void_p
x.XFlush.argtypes = [c.c_void_p]
x.XFree.argtypes = [c.c_void_p]
x.XCloseDisplay.argtypes = [c.c_void_p]
t.XTestFakeMotionEvent.argtypes = [c.c_void_p, c.c_int, c.c_int, c.c_int, c.c_ulong]


class Cursor(c.Structure):
    _fields_ = [('x', c.c_short), ('y', c.c_short), ('width', c.c_ushort),
                ('height', c.c_ushort), ('xhot', c.c_ushort), ('yhot', c.c_ushort),
                ('serial', c.c_ulong), ('pixels', c.POINTER(c.c_ulong)),
                ('atom', c.c_ulong), ('name', c.c_char_p)]


fixes.XFixesGetCursorImage.argtypes = [c.c_void_p]
fixes.XFixesGetCursorImage.restype = c.POINTER(Cursor)
display = x.XOpenDisplay(None)
assert display
failures = []


def check(condition, description):
    print(('ok' if condition else 'not ok') + ' - ' + description, flush=True)
    if not condition:
        failures.append(description)


def move(px, py):
    dispatch(f'hl.dsp.cursor.move({{x={px},y={py}}})')
    t.XTestFakeMotionEvent(display, -1, px * 2, py * 2, 0)
    x.XFlush(display)


def popups():
    return [w for w in query('clients') if w['class'] == 'affinity.exe' and w['address'] != main['address']]


try:
    mx, my = main['at']
    dispatch(f'hl.dsp.focus({{window="address:{main["address"]}"}})')
    for label, offset in [('Artboard', 173), ('Node', 210), ('Corner', 246)]:
        move(mx + 300, my + 450)
        left = time.monotonic()
        while popups() and time.monotonic() - left < 1:
            time.sleep(0.04)
        check(not popups(), 'previous tooltip dismisses within one second after leaving')
        print(json.dumps({'dismissal_seconds': round(time.monotonic() - left, 3)}), flush=True)
        move(mx + 20, my + offset)
        started = time.monotonic()
        tip = None
        while time.monotonic() - started < 4:
            current = popups()
            if current:
                tip = current[0]
                break
            time.sleep(0.04)
        check(tip is not None, label + ' tooltip appears')
        if tip is None:
            continue
        print(json.dumps({'tool': label, 'appearance_seconds': round(time.monotonic() - started, 3),
                          'at': tip['at'], 'size': tip['size']}), flush=True)
        # Give the compositor time to finish focus processing before checking.
        time.sleep(0.1)
        check(query('activewindow').get('address') == main['address'], label + ' tooltip does not steal focus')
        check(mx <= tip['at'][0] <= mx + 90 and abs(tip['at'][1] - (my + offset)) < 60,
              label + ' tooltip stays beside its tool')
        for prop, expected in [('no_anim', 'true'), ('no_follow_mouse', 'true'), ('border_size', '0')]:
            value = subprocess.check_output(['hyprctl', 'getprop', 'address:' + tip['address'], prop], text=True).strip()
            check(value == expected, label + ': ' + prop + '=' + expected + ' (observed ' + value + ')')
        time.sleep(0.25)
        check(any(w['address'] == tip['address'] for w in popups()), label + ' tooltip remains stable while hovering')
    move(mx + 300, my + 450)
    time.sleep(0.3)
    cursor = fixes.XFixesGetCursorImage(display)
    try:
        expected = int(os.environ.get('OMARCHY_AFFINITY_CURSOR_SIZE', int(os.environ.get('XCURSOR_SIZE', '24')) * 2))
        check(cursor.contents.width == expected and cursor.contents.height == expected,
              f'standard cursor matches 2x desktop: {cursor.contents.width}x{cursor.contents.height}, expected {expected}')
    finally:
        x.XFree(cursor)
finally:
    move(original['x'], original['y'])
    x.XCloseDisplay(display)

raise SystemExit(1 if failures else 0)
